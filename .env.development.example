# Database configuration for Docker
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/heart-disease?schema=public"
# Auth configuration
JWT_SECRET="cardioai-dev-secret-key-do-not-use-in-production"
# AI/Ollama configuration
# Use host.docker.internal to reach Ollama running on the host machine
OLLAMA_BASE_URL="http://host.docker.internal:11434"
OLLAMA_MODEL="minimax-m2.5:cloud"
# MCP Server configuration
# Assuming the MCP server is running on the host machine
MCP_SERVER_URL="http://host.docker.internal:3001"
# Application configuration
NODE_ENV="development"
LOG_LEVEL="info"
ENV_FILE=.env.development
NODE_ENV=development