{
  "name": "heart-disease",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "docker:make:admin:dev": "docker compose exec app npx tsx scripts/make-admin.ts",
    "docker:build:dev": "docker compose --profile tools --env-file .env.development build --no-cache",
    "docker:watch:dev": "NODE_ENV=development docker compose --profile tools --env-file .env.development up --watch",
    "docker:up:dev": "NODE_ENV=development docker compose --profile tools --env-file .env.development up --build app postgres studio",
    "docker:down:dev": "docker compose --profile tools --env-file .env.development down",
    "docker:logs:dev": "docker compose --profile tools --env-file .env.development logs -f app",
    "docker:ps:dev": "docker compose --profile tools --env-file .env.development ps",
    "docker:exec:app": "docker compose exec app sh",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "types": "tsc --project tsconfig.json --noEmit",
    "docker:test:dev": "docker compose exec app npx jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "type": "module",
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "jose": "^6.2.1",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "pg": "^8.20.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.2",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.0.8",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.37",
    "@types/pg": "^8.18.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.8.1",
    "prisma": "^7.5.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.10",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
