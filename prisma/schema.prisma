generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int     @id @default(autoincrement())
  name     String
  email    String  @unique
  password String
  image    String?
  role     Role    @default(USER)
  chats    Chat[]
  prompt   Prompt?
}

model Chat {
  id        Int       @id @default(autoincrement())
  title     String?
  token     String    @unique
  userId    Int
  createdAt DateTime  @default(now())
  isShared  Boolean   @default(false)
  sharedAt  DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
}

model Message {
  id        Int      @id @default(autoincrement())
  chatId    Int
  actor     Actor
  message   String
  createdAt DateTime @default(now())
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

model Prompt {
  id     Int    @id @default(autoincrement())
  prompt String
  userId Int    @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SystemConfig {
  id            Int      @id @default(1)
  defaultPrompt String   @db.Text
  updatedAt     DateTime @updatedAt
}

enum Actor {
  USER
  ASSISTANT
}

enum Role {
  USER
  ADMIN
}
