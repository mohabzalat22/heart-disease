generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int    @id @default(autoincrement())
  password String
  name     String
  email    String @unique
  image    String?

  /**
   * relations
   */
  chats  Chat[]
  prompt Prompt?
}

model Chat {
  id        Int       @id @default(autoincrement())
  title     String?
  token     String    @unique
  userId    Int
  createdAt DateTime  @default(now())
  /**
   * relations
   */
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  messages  Message[]
}

enum Actor {
  USER
  ASSISTANT
}

model Message {
  id        Int      @id @default(autoincrement())
  chatId    Int
  actor     Actor
  message   String
  createdAt DateTime @default(now())

  /**
   * relations
   */
  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model Prompt {
  id     Int    @id @default(autoincrement())
  prompt String 
  userId Int    @unique

  /**
   * relations
   */
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}